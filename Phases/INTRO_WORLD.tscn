[sub_resource type="Resource" id="Resource_sqaok"]
script = ExtResource("12_875ti")
text = "Hey there! Welcome in."
sfx = null
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_wn2dn"]
script = ExtResource("12_875ti")
text = "You don't look like you're from around here."
sfx = null
portrait_key = "neutral"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_ml0x8"]
script = ExtResource("12_875ti")
text = "You're not some inspector or something... right?"
sfx = null
portrait_key = "concerned"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_dnod1"]
script = ExtResource("12_wn2dn")
speaker = "Cashier"
portrait_key = "happy"
lines = Array[ExtResource("12_875ti")]([SubResource("Resource_sqaok"), SubResource("Resource_wn2dn"), SubResource("Resource_ml0x8")])
metadata/_custom_type_script = "uid://dbiae2rlq18dl"

[sub_resource type="Resource" id="Resource_lk0oh"]
script = ExtResource("12_875ti")
text = "My name is Tim! This is my shop. It may seem like a gas station to you, but don't be so naive."
sfx = null
portrait_key = "proud"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_hgrjg"]
script = ExtResource("12_875ti")
text = "Cuz' you're standing in the future greatest game shop in the world!"
sfx = null
portrait_key = "happy"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_ojarg"]
script = ExtResource("12_875ti")
text = "You play right?"
sfx = null
portrait_key = "happy"
choices = Array[String](["Play what?", "Of course"])
next_indices = Array[int]([3, 7])
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_lcn6i"]
script = ExtResource("12_875ti")
text = "What?!?!"
sfx = null
portrait_key = "concerned"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_8dfl2"]
script = ExtResource("12_875ti")
text = "What do you mean play what?!?!"
sfx = null
portrait_key = "concerned"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_esa3u"]
script = ExtResource("12_875ti")
text = "Cards of Eternity? Only the worlds hottest card / board game being played right now!"
sfx = null
portrait_key = "proud"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_1eshp"]
script = ExtResource("12_875ti")
end_after_line = true
text = "Im almost ashamed to have you in here... look over there. Some kids left some common cards on the counter. Go grab them, it'll get you started."
sfx = null
portrait_key = "neutral"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_4u7mm"]
script = ExtResource("12_875ti")
text = "That's what I like to hear! We should definetely battle some time. It would be a blast..."
sfx = null
portrait_key = "happy"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

[sub_resource type="Resource" id="Resource_itvu8"]
script = ExtResource("12_875ti")
end_after_line = true
text = "Hey you see that over there on my counter? Looks like some kids left some common cards. They're yours if you want!"
sfx = null
portrait_key = "proud"
metadata/_custom_type_script = "uid://dk3qs7y52r5yr"

