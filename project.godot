; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ambientcg]

extract_path="res://AmbientCG/Downloads"
material_file_directory="res://AmbientCG/Materials"
environment_file_directory="res://AmbientCG/Environments"

[application]

config/name="Cards of Eternity"
run/main_scene="uid://bp0h2hrcf2ohw"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CardCollection="*res://UI/CardCollection.gd"
BattleManager="*res://Arena/Arena3D/BattleManager.gd"
TerrainManager="*res://UI/Terrains/TerrainManager.gd"
DeckManager="*res://UI/DeckManager.gd"
DialogueManager="*res://Dialogue/DialogueManager.gd"
EscMenu="*res://UI/Esc_Menu.tscn"
InputState="*res://inputstate.gd"
Globals="*res://Globals.gd"
GameSession="*res://GameSession.gd"
DialogueUi="*res://Dialogue/dialogue_ui.tscn"
TutorialManager="*res://World/tutorial_manager.gd"
GameSettings="*res://GameSettings.gd"
TransitionFade="*res://TransitionFade.tscn"
TransitionFadeScript="*res://transition_fade.gd"
CardDb="*res://CardDB.gd"
FrozenStatusEffect="*res://Cards/Abilities/FrozenStatusEffect.gd"

[display]

window/size/initial_screen=1
window/size/always_on_top=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/ambientcg/plugin.cfg", "res://addons/godot_3d_cursor/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[global_group]

player=""
overworld=""
battle_scene=""
npcs=""
sit_spots=""
interactable=""
element_deck="StarterDeckDisableGroup"
tutorial_portal=""
guide=""
card_pickups=""
taskbar=""
Camera2D=""

